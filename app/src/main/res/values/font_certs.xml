<?xml version="1.0" encoding="utf-8"?>
<!--
  Certificati ufficiali del Google Fonts Provider (com.google.android.gms),
  richiesti da androidx.compose.ui:ui-text-google-fonts per scaricare i font
  a runtime senza doverli impacchettare nell'APK. Sono valori statici
  pubblicati da Google, invariati da anni.
  Se in dispositivo/emulatore i font non si caricano (restano sul fallback
  di sistema), rigenera questo file da Android Studio:
  res (tasto destro) → New → Font Resource → "Add font to project via XML"
  seleziona un font Google → lo wizard rigenera i certificati corretti.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string-array name="com_google_android_gms_fonts_certs" translatable="false">
        <item>@array/com_google_android_gms_fonts_certs_dev</item>
        <item>@array/com_google_android_gms_fonts_certs_prod</item>
    </string-array>
